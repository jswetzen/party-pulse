# Copy to .env (or set as real env vars / a podman-compose env_file) and fill in.

# Required in production (DJANGO_DEBUG=0). Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# 1 for local dev (allows an insecure default secret key + permissive host checks), 0 in production.
DJANGO_DEBUG=1

# Comma-separated. Required when DJANGO_DEBUG=0.
DJANGO_ALLOWED_HOSTS=party-pulse.example.com

# Optional: override the sqlite file path. Defaults to BASE_DIR/db.sqlite3
# for bare `manage.py runserver` dev; the container image sets this to
# /data/db.sqlite3 itself (see Dockerfile) so it doesn't need setting here
# for a container deploy — /data just needs to be a mounted volume.
DJANGO_DB_PATH=/data/db.sqlite3
